---
// Every page says it is a private preview until DOCS_GA=true (src/components/ga.ts).
import Default from '@astrojs/starlight/components/Banner.astro';
import { ga } from './ga.ts';
---

{
	!ga ? (
		<div class="sl-banner hc-preview">
			<strong>Private preview.</strong> These docs and Hardcharger's packages are internal to GizmoData until launch. Please don’t share links outside the company.
		</div>
	) : (
		<Default />
	)
}

<style>
	.hc-preview {
		background: linear-gradient(90deg, #f15a24, #31a8db);
		color: #fff;
		font-size: var(--sl-text-sm);
		padding: 0.4rem 1rem;
		text-align: center;
	}
</style>
