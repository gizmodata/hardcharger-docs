---
// The version these pages describe, ahead of Starlight's social links. Versioned docs
// (starlight-versions) can replace this badge with a picker once a version is archived.
// The private preview describes the release candidate as built from main; the public site
// (DOCS_GA=true, src/components/ga.ts) describes the release.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { ga } from './ga.ts';
import { version as serverVersion } from '../data/server-version.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const version = ga ? serverVersion : `${serverVersion} · main`;
const title = `These docs describe Hardcharger ${serverVersion}${ga ? '' : ', as built from its main branch'}`;
---

<a class="hc-version" href={`${base}/reference/versions/`} title={title}>
	{version}
</a>
<Default />

<style>
	.hc-version {
		display: inline-flex;
		align-items: center;
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		text-decoration: none;
		color: var(--sl-color-white);
		border: 1px solid transparent;
		background:
			linear-gradient(var(--sl-color-bg-nav), var(--sl-color-bg-nav)) padding-box,
			var(--hc-gradient) border-box;
		white-space: nowrap;
	}
	@media (max-width: 50rem) {
		.hc-version {
			display: none;
		}
	}
</style>
