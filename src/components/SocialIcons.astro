---
// The version these pages describe, ahead of Starlight's social links. Versioned docs
// (starlight-versions) can replace this badge with a picker once 0.3.0 is archived.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a class="hc-version" href={`${base}/reference/versions/`} title="These docs describe main (unreleased) and Hardcharger 0.2.0">
	latest · main
</a>
<Default />

<style>
	.hc-version {
		display: inline-flex;
		align-items: center;
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		text-decoration: none;
		color: var(--sl-color-white);
		border: 1px solid transparent;
		background:
			linear-gradient(var(--sl-color-bg-nav), var(--sl-color-bg-nav)) padding-box,
			var(--hc-gradient) border-box;
		white-space: nowrap;
	}
	@media (max-width: 50rem) {
		.hc-version {
			display: none;
		}
	}
</style>
